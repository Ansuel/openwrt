From 35887e8ba0080efa501224ab5ca209c8d1295cfc Mon Sep 17 00:00:00 2001
From: Christian Marangi <ansuelsmth@gmail.com>
Date: Tue, 30 Sep 2025 23:04:15 +0200
Subject: [PATCH 34/59] configs: enable PCS for Airoha AN7581/AN7583

Enable PCS config for Airoha AN7581/AN7583 SoC by default to enable
support fo External PHY.

Signed-off-by: Christian Marangi <ansuelsmth@gmail.com>
---
 configs/an7581_evb_defconfig | 2 ++
 configs/an7583_evb_defconfig | 2 ++
 2 files changed, 4 insertions(+)

diff --git a/configs/an7581_evb_defconfig b/configs/an7581_evb_defconfig
index 8e2c694dbbb..606689c829d 100644
--- a/configs/an7581_evb_defconfig
+++ b/configs/an7581_evb_defconfig
@@ -66,9 +66,11 @@ CONFIG_SPI_FLASH_STMICRO=y
 CONFIG_SPI_FLASH_WINBOND=y
 CONFIG_SPI_FLASH_MTD=y
 CONFIG_AIROHA_ETH=y
+CONFIG_PCS_AIROHA_AN7581=y
 CONFIG_DM_MDIO=y
 CONFIG_CMD_MII=y
 CONFIG_CMD_MDIO=y
+CONFIG_PHYLIB=y
 CONFIG_PHY=y
 CONFIG_PINCTRL=y
 CONFIG_PINCONF=y
diff --git a/configs/an7583_evb_defconfig b/configs/an7583_evb_defconfig
index 41d98bab5de..7bf77a296e0 100644
--- a/configs/an7583_evb_defconfig
+++ b/configs/an7583_evb_defconfig
@@ -65,9 +65,11 @@ CONFIG_SPI_FLASH_STMICRO=y
 CONFIG_SPI_FLASH_WINBOND=y
 CONFIG_SPI_FLASH_MTD=y
 CONFIG_AIROHA_ETH=y
+CONFIG_PCS_AIROHA_AN7583=y
 CONFIG_DM_MDIO=y
 CONFIG_CMD_MII=y
 CONFIG_CMD_MDIO=y
+CONFIG_PHYLIB=y
 CONFIG_PHY=y
 CONFIG_PINCTRL=y
 CONFIG_PINCONF=y
-- 
