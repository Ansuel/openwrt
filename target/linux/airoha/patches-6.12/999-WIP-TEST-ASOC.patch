 sound/soc/mediatek/common/mtk-afe-fe-dai.c | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/sound/soc/mediatek/common/mtk-afe-fe-dai.c b/sound/soc/mediatek/common/mtk-afe-fe-dai.c
index 3809068f5620..666ae787cf71 100644
--- a/sound/soc/mediatek/common/mtk-afe-fe-dai.c
+++ b/sound/soc/mediatek/common/mtk-afe-fe-dai.c
@@ -503,10 +503,14 @@ static int mtk_memif_set_rate_fs(struct mtk_base_afe *afe,
 int mtk_memif_set_rate_substream(struct snd_pcm_substream *substream,
 				 int id, unsigned int rate)
 {
+	pr_info("SET RATE SUBSTREAM %lx\n", (unsigned long int)substream);
 	struct snd_soc_pcm_runtime *rtd = snd_soc_substream_to_rtd(substream);
+	pr_info("SET RATE RTD %lx\n", (unsigned long int)rtd);
 	struct snd_soc_component *component =
 		snd_soc_rtdcom_lookup(rtd, AFE_PCM_NAME);
+	pr_info("SET RATE COMPONENT %lx\n", (unsigned long int)component);
 	struct mtk_base_afe *afe = snd_soc_component_get_drvdata(component);
+	pr_info("SET RATE AFE %lx\n", (unsigned long int)afe);
 
 	int fs = 0;
 
